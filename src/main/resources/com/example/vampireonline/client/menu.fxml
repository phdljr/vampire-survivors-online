<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<BorderPane prefHeight="600.0" prefWidth="960.0" styleClass="start-root"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.vampireonline.client.MenuController">
    <stylesheets>
        <URL value="@styles.css"/>
    </stylesheets>
    <center>
        <VBox alignment="CENTER" maxWidth="620.0" spacing="24.0">
            <Label styleClass="start-title" text="VAMPIRE ONLINE"/>
            <Label styleClass="start-subtitle" text="생존하고, 지키고, 점수를 올리세요!"/>
            <GridPane hgap="10.0" maxWidth="460.0" styleClass="menu-panel" vgap="10.0">
                <padding>
                    <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
                </padding>
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="70.0"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="260.0"/>
                </columnConstraints>

                <Label styleClass="field-label" text="Name" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label styleClass="field-label" text="Host" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="hostField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label styleClass="field-label" text="Port" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="portField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <HBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <Button maxWidth="1.7976931348623157E308" onAction="#hostLocal" styleClass="primary-button" text="혼자하기" HBox.hgrow="ALWAYS"/>
                    <Button maxWidth="1.7976931348623157E308" onAction="#joinServer" styleClass="secondary-button" text="참여하기" HBox.hgrow="ALWAYS"/>
                </HBox>

                <Label fx:id="statusLabel" styleClass="status-label" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
            </GridPane>
        </VBox>
    </center>
</BorderPane>
