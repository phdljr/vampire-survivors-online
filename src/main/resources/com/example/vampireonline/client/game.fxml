<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<StackPane fx:id="rootPane" focusTraversable="true" prefHeight="720.0" prefWidth="1280.0"
           style="-fx-background-color: #11131A;"
           xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.vampireonline.client.GameController">
    <stylesheets>
        <URL value="@styles.css"/>
    </stylesheets>
    <Canvas fx:id="gameCanvas" height="720.0" width="1280.0"/>
    <VBox fx:id="upgradePane" alignment="CENTER" managed="false" maxWidth="820.0" spacing="18.0"
          styleClass="upgrade-pane" visible="false">
        <Label fx:id="upgradeTitleLabel" styleClass="upgrade-title" text="Level Up"/>
        <HBox fx:id="upgradeCardBox" alignment="CENTER" spacing="14.0"/>
    </VBox>
</StackPane>
